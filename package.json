{
  "name": "dualtran",
  "description": "AI-powered browser extension that translates web pages and displays the translated text with the original text in the same page.",
  "version": "1.0.0",
  "browserslist": [
    "firefox 63",
    "chrome 70"
  ],
  "scripts": {
    "dev": "webpack --config webpack.dev.js --watch",
    "build": "webpack --config webpack.production.js",
    "dev-polyfill": "webpack --config polyfill.webpack.dev.js",
    "build-polyfill": "webpack --config polyfill.webpack.production.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ai": "vitest run tests/ai",
    "test:manifest": "vitest run tests/manifest",
    "test:browser-e2e": "node tests/browser-e2e/run-all.mjs",
    "test:browser-e2e:aimock": "node tests/browser-e2e/run-all.mjs --mock-mode=aimock",
    "test:e2e:all": "node tests/browser-e2e/run-all.mjs",
    "test:e2e:smoke": "node tests/browser-e2e/run-all.mjs --smoke",
    "test:e2e:translation": "node tests/browser-e2e/run-all.mjs --scenario=translation",
    "test:e2e:popup": "node tests/browser-e2e/run-all.mjs --scenario=popup-controls",
    "test:e2e:settings-translation": "node tests/browser-e2e/run-all.mjs --scenario=settings-translation",
    "test:e2e:settings-appearance": "node tests/browser-e2e/run-all.mjs --scenario=settings-appearance",
    "test:e2e:settings-advanced": "node tests/browser-e2e/run-all.mjs --scenario=settings-advanced",
    "test:e2e:error-edge": "node tests/browser-e2e/run-all.mjs --scenario=error-edge",
    "test:e2e:install": "node tests/browser-e2e/run-all.mjs --scenario=install-firstrun",
    "test:e2e:provider-migration": "node tests/browser-e2e/run-all.mjs --scenario=provider-migration",
    "test:e2e:models-dev-cache": "node tests/browser-e2e/run-all.mjs --scenario=models-dev-cache",
    "test:e2e:i18n": "node tests/browser-e2e/run-all.mjs --scenario=i18n-behavior",
    "test:all": "vitest run --coverage && npm run test:browser-e2e",
    "test:pre-publish": "npm run build && vitest run --coverage && npm run test:browser-e2e",
    "postbuild": "vitest run tests/manifest",
    "mock:llm": "node tests/mock-server/mock-llm-server-aimock.js",
    "mock:llm:aimock": "node tests/mock-server/mock-llm-server-aimock.js",
    "i18n:check": "node scripts/sync-locales.js --dry --fail-on-extra",
    "i18n:sync": "node scripts/sync-locales.js --prune-extras",
    "i18n:apply": "node scripts/apply-i18n-translations.js",
    "i18n:verify": "node scripts/check-i18n-equals-en.js --strict",
    "map": "npm merge-source-maps --inline-sources --inline-source-map all.min.js"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^4.0.117",
    "@ai-sdk/anthropic": "^3.0.82",
    "@ai-sdk/azure": "^3.0.71",
    "@ai-sdk/cerebras": "^2.0.56",
    "@ai-sdk/cohere": "^3.0.38",
    "@ai-sdk/deepinfra": "^2.0.54",
    "@ai-sdk/deepseek": "^2.0.35",
    "@ai-sdk/gateway": "^3.0.132",
    "@ai-sdk/google": "^3.0.80",
    "@ai-sdk/google-vertex": "^4.0.145",
    "@ai-sdk/groq": "^3.0.41",
    "@ai-sdk/mistral": "^3.0.39",
    "@ai-sdk/openai": "^3.0.69",
    "@ai-sdk/perplexity": "^3.0.35",
    "@ai-sdk/togetherai": "^2.0.55",
    "@ai-sdk/vercel": "^2.0.52",
    "@ai-sdk/xai": "^3.0.93",
    "@aihubmix/ai-sdk-provider": "^2.2.1",
    "@jerome-benoit/sap-ai-provider-v2": "^4.7.1",
    "@openrouter/ai-sdk-provider": "^2.9.1",
    "ai": "^6.0.199",
    "ai-gateway-provider": "^3.1.3",
    "common-tags": "^1.8.2",
    "core-js": "^3.26.1",
    "eventsource-parser": "^1.0.0",
    "gitlab-ai-provider": "^6.9.3",
    "gpt-tokenizer": "^2.1.1",
    "koa": "^2.16.4",
    "koa-bodyparser": "^4.4.1",
    "merge-gateway-ai-sdk-provider": "^0.1.0",
    "toastify-js": "^1.12.0",
    "toolcool-color-picker": "^1.0.15",
    "venice-ai-sdk-provider": "^2.1.1"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.60.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.20.2",
    "@copilotkit/aimock": "1.14.0",
    "@types/chrome": "^0.0.203",
    "@types/firefox-webext-browser": "^94.0.1",
    "@vitest/coverage-v8": "^0.34.6",
    "babel-loader": "^9.1.2",
    "babelify": "^10.0.0",
    "browserify": "^17.0.0",
    "concat-with-sourcemaps": "^1.1.0",
    "copy-webpack-plugin": "11.0.0",
    "esbuild": "^0.28.0",
    "fake-indexeddb": "^5.0.2",
    "filemanager-webpack-plugin": "^8.0.0",
    "gulp": "^4.0.2",
    "gulp-babel": "^8.0.0",
    "gulp-sourcemaps": "^3.0.0",
    "gulp-zip": "^5.1.0",
    "jsdom": "^22.1.0",
    "merge-source-maps": "^0.6.1",
    "playwright": "^1.53.0",
    "vitest": "^0.34.6",
    "webpack": "^5.80.0",
    "webpack-cli": "^5.0.1",
    "webpack-merge": "^5.8.0"
  },
  "main": "build.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "keywords": [
    "translation",
    "chrome-extension",
    "ai-translation",
    "google-translate",
    "browser-extension",
    "web-translation",
    "llm"
  ],
  "author": "seigwen",
  "license": "MPL-2.0",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/seigwen/DualTran-extension.git"
  },
  "homepage": "https://github.com/seigwen/DualTran-extension#readme",
  "bugs": {
    "url": "https://github.com/seigwen/DualTran-extension/issues"
  }
}
