{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "DualTran",
	"version": "2.1.30",
	"description": "AI-powered browser extension that translates web pages and displays the translated text with the original text in the same page.",
  // Register default keyboard shortcuts. Docs: https://developer.chrome.com/docs/extensions/mv3/declare_commands/
  "commands": {
    "hotkey-toggle-translation": {
      "suggested_key": {
        "default": "Alt+T"
      },
      "description": "__MSG_lblSwitchTranslatedAndOriginal__"
    },
    "hotkey-translate-selected-text": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "__MSG_msgTranslateSelectedText__"
    },
    "hotkey-swap-page-translation-service": {
      "suggested_key": {
        "default": "Alt+Q"
      },
      "description": "__MSG_swapTranslationService__"
    }
    ,
    "hotkey-show-original": {
      "description": "__MSG_lblRestorePageToOriginal__"
    },
    "hotkey-translate-page-1": {
      "description": "__MSG_lblTranslatePageToTargetLanguage__ 1"
    },
    "hotkey-translate-page-2": {
      "description": "__MSG_lblTranslatePageToTargetLanguage__ 2"
    },
    "hotkey-translate-page-3": {
      "description": "__MSG_lblTranslatePageToTargetLanguage__ 3"
    },
    "hotkey-hot-translate-selected-text": {
      "description": "__MSG_lblHotTranslatedSelectedText__"
    }
  },

  "icons": {
    "32": "/icons/icon-32.png",
    "64": "/icons/icon-64.png",
    "128": "/icons/icon-128.png"
  },

  // https://developer.chrome.com/docs/extensions/reference/permissions/#manifest
  // https://developer.chrome.com/docs/extensions/mv3/declare_permissions/
  // List required permissions for core extension functionality here.
  // For permissions listed here, the browser prompts the user only once. When upgrading, new permissions here disable the extension until re-enabled. Use optional_permissions for feature-specific permissions.
  "permissions": [
    // Storage permission — required to call chrome.storage API
    "storage",
    // activeTab grants temporary extra permissions for the active tab when the user interacts with the extension
    // (e.g., clicking the icon, context menu, keyboard shortcut, or omnibox suggestion). Includes scripting.insertCSS, tabs.Tab, request interception, etc.
    "activeTab", 
    // Required to call chrome.contextMenus API
    "contextMenus",
    // Required for chrome.webRequest API — listen to HTTP request lifecycle events to observe/analyze traffic.
    // In this extension, used in onHeadersReceived hook to get the document's MIME type.
    "webRequest",
    // Required for chrome.alarms API. Used to auto-translate pages 600ms after DOMContentLoaded. Note: intervals less than 1 min may not work reliably.
    "alarms",
    // Required to send requests from the offscreen document.
    "offscreen",
    // Required to use declarativeNetRequest API to modify request headers (e.g., User-Agent spoofing to Edge).
    "declarativeNetRequest"
  ],

  // Permissions only needed for certain features can be listed here. Then use chrome.permissions.request dynamically.
  // Note: calling chrome.permissions.request shows a browser dialog explaining the permission.
  // When upgrading, if only optional permissions are added, Chrome will NOT disable the extension for existing users.
  "optional_permissions": [
    // Required for chrome.webNavigation API — receive notifications about navigation request states.
    // In this extension, used to auto-translate when a clicked link's domain matches the current domain.
    "webNavigation"
  ],

  
  // https://developer.mozilla.org/en-US/docs/Mozilla/Add-ons/WebExtensions/manifest.json/host_permissions
  // https://extensionworkshop.com/documentation/develop/request-the-right-permissions/
  // Declare which hosts the extension can read/write data for (e.g., cookies, webRequest, tabs).
  // If set, there's no need to add activeTab in the permissions array.
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://translate.google.com/*",
    "https://translate.yandex.net/*",
    "https://www.bing.com/*",
    "https://www.deepl.com/*",
    "https://edge.microsoft.com/*",
    "https://api-edge.cognitive.microsofttranslator.com/*",
    "https://api.openai.com/*",
    "https://openrouter.ai/*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.deepseek.com/*",
    "https://api.x.ai/*",
    "https://*.openai.azure.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],

  // Similar to host_permissions, but the browser does not prompt upfront. Use chrome.permissions.request in business logic instead.
  // "optional_host_permissions": [
  // ],
  
  // Web-accessible resources are extension files accessible by web pages or other extensions.
  // Making resources public (as in Manifest V2 defaults) allows websites/attackers to detect the extension, enabling fingerprinting.
  // Provide an array of objects to limit access. An empty array means no external access to extension resources.
  "web_accessible_resources": [
    {
      "resources": [
        "/icons/icon-16.png",
        "/icons/icon-32.png",
        "/icons/icon-64-translated.png",
        "/icons/icon-64.png",
        "/icons/icon-128.png",
        "/icons/icon-256.png",
        "/icons/google-translate-32.png",
        "/icons/yandex-translate-32.png",
        "/icons/swap-32.png",
        "/contentScript/css/*",
        "/contentScript/*.js",
        "/lib/*.js",
        "/lib/ai/*.js",
        "/util/*.js"
      ],
      "matches": [
        "*://*/*"
      ]
    }
  ],

  "options_ui": {
    "page": "/options/options.html",
    "open_in_tab": false,
    "browser_style": false
  },

  "action": {
    "browser_style": false,
    "default_icon": "/icons/icon-32.png",
    "default_title": "__MSG_pageActionTitle__",
    "default_popup": "/popup/popup.html"  // optional

  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "run_at": "document_start",
      "all_frames": false,
      "js": ["/contentScript/checkScriptIsInjected.js"]
    },
    {
      "matches": ["<all_urls>"],
      "run_at": "document_end",
      "all_frames": true,
      "match_about_blank": true,
      "js": [
        "/contentScript/contentScript.js"
      ],
      "type": "module"
    },
    {
      "matches": ["https://www.deepl.com/translator*"],
      "run_at": "document_end",
      "all_frames": false,
      "js": ["/contentScript/deepl.js"]
    }
  ],

  "background": {
    "service_worker": "/background/sw.js",
    "type": "module" 
  },

  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "dualtran_rules",
        "enabled": true,
        "path": "/rules/request_modifier_rule.json"
      }
    ]
  }
}
