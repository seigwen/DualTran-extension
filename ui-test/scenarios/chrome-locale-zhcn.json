{
  "id": "chrome-locale-zhcn",
  "host": "dualtran-extension",
  "axis": "ui-language",
  "covers": [
    "options.ui.language"
  ],
  "actions": [
    {
      "type": "goto",
      "url": "chrome-extension://${DT_EXTENSION_ID}/options/options.html"
    },
    {
      "type": "wait",
      "ms": 3000
    },
    {
      "type": "screenshot",
      "name": "locale-main",
      "rubric": "chrome-locale-zhcn"
    }
  ]
}