{
  "id": "chrome-page-en",
  "host": "dualtran-extension",
  "axis": "target-language",
  "covers": [
    "options.languages.target_page",
    "translate.page"
  ],
  "actions": [
    {
      "type": "goto",
      "url": "chrome-extension://${DT_EXTENSION_ID}/options/options.html"
    },
    {
      "type": "wait",
      "ms": 2500
    },
    {
      "type": "selectOption",
      "selector": "#selectTargetLanguage",
      "value": "en"
    },
    {
      "type": "selectOption",
      "selector": "#selectTargetLanguageForText",
      "value": "en"
    },
    {
      "type": "clickText",
      "text": "Translations"
    },
    {
      "type": "wait",
      "ms": 700
    },
    {
      "type": "selectOption",
      "selector": "#whereToDisplayTranslatedText",
      "value": "replaceOriginal"
    },
    {
      "type": "wait",
      "ms": 1000
    },
    {
      "type": "goto",
      "url": "http://127.0.0.1:8080/test-zh.html"
    },
    {
      "type": "wait",
      "ms": 2500
    },
    {
      "type": "screenshot",
      "name": "page-panel",
      "rubric": "chrome-page-panel"
    },
    {
      "type": "clickAt",
      "x": 1553,
      "y": 479
    },
    {
      "type": "wait",
      "ms": 14000
    },
    {
      "type": "screenshot",
      "name": "page-translated",
      "rubric": "chrome-page-en"
    }
  ]
}