{
  "id": "chrome-locale-zhtw",
  "host": "dualtran-extension",
  "axis": "ui-language",
  "covers": [
    "options.ui.language"
  ],
  "actions": [
    {
      "type": "goto",
      "url": "chrome-extension://${DT_EXTENSION_ID}/options/options.html"
    },
    {
      "type": "wait",
      "ms": 3000
    },
    {
      "type": "screenshot",
      "name": "locale-main",
      "rubric": "chrome-locale-zhtw"
    }
  ],
  "env": {
    "DT_BROWSER_LOCALE": "zh-TW",
    "DT_BROWSER_ACCEPT_LANGUAGE": "zh-TW,zh;q=0.9"
  }
}